type: software
title: "odoo-json2: dependency-free TypeScript and Python clients for Odoo's External JSON-2 API"
version: 0.1.0
date-released: "2026-11-10"
license: MIT
authors:
  - name: "TicketWave HQ Ltd"
repository-code: "https://github.com/TicketWaveHQ/odoo-json2"
